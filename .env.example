# ==============================================================================
# SUIT & STITCH - PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server HTTP Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS) allowed origin(s)
# In production, set to your live deployment domain (e.g. https://suit-and-stitch.onrender.com)
CORS_ORIGIN=*

# PostgreSQL Relational Database Connection String (Neon, Supabase, AWS RDS, etc.)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JSON Web Token (JWT) Security Secrets
# Generate a cryptographically strong secret (min 32 characters)
JWT_SECRET="your-ultra-secure-jwt-secret-key-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
